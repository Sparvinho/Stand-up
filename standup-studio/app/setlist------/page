"use client";

import { useState, useEffect } from "react";
import { ListMusic, Plus, Save, Trash2, Check, MapPin, ArrowRight, FolderOpen, GripVertical } from "lucide-react";
import { supabase } from "../../lib/supabase";
import { useRouter } from "next/navigation";

export default function Setlists() {
  const router = useRouter();
  
  const [savedSetlists, setSavedSetlists] = useState<any[]>([]);
  const [allBits, setAllBits] = useState<any[]>([]);
  
  const [activeId, setActiveId] = useState<string | null>(null);
  const [title, setTitle] = useState("");
  const [venue, setVenue] = useState("");
  
  const [setlist, setSetlist] = useState<string[]>([]);
  
  const [isSaving, setIsSaving] = useState(false);
  const [saved, setSaved] = useState(false);

  // Nytt: Minne för vilket skämt vi drar i just nu
  const [draggedIndex, setDraggedIndex] = useState<number | null>(null);

  useEffect(() => {
    fetchData();
  }, []);

  const fetchData = async () => {
    const { data: bitsData } = await supabase.from("bits").select("*");
    if (bitsData) setAllBits(bitsData);

    const { data: setlistsData } = await supabase.from("setlists").select("*").order("created_at", { ascending: false });
    if (setlistsData) {
      const safeData = setlistsData.map(r => ({
        ...r,
        bit_ids: Array.isArray(r.bit_ids) ? r.bit_ids : []
      }));
      setSavedSetlists(safeData);
    }
  };

  const loadSetlist = (setlistObj: any) => {
    setActiveId(setlistObj.id);
    setTitle(setlistObj.title || "");
    setVenue(setlistObj.venue || "");
    setSetlist(setlistObj.bit_ids || []);
  };

  const startNew = () => {
    setActiveId(null);
    setTitle("");
    setVenue("");
    setSetlist([]);
  };

  const handleSave = async () => {
    setIsSaving(true);
    
    if (activeId) {
      const { error } = await supabase
        .from("setlists")
        .update({ title, venue, bit_ids: setlist })
        .eq("id", activeId);
      
      if (!error) {
        showSaved();
        fetchData();
      }
    } else {
      const { data, error } = await supabase
        .from("setlists")
        .insert([{ title, venue, bit_ids: setlist }])
        .select()
        .single();
      
      if (data && !error) {
        setActiveId(data.id);
        showSaved();
        fetchData();
      }
    }
    setIsSaving(false);
  };

  // NYTT: Funktion som sparar och sen navigerar till Workshopen
  const handleSaveAndNavigate = async (bitId: string) => {
    if (!title) {
      alert("Ge din setlist ett namn (Arbetstitel) först så vi kan spara ordningen innan vi byter sida!");
      return;
    }
    
    setIsSaving(true);
    if (activeId) {
      await supabase.from("setlists").update({ title, venue, bit_ids: setlist }).eq("id", activeId);
    } else {
      const { data } = await supabase.from("setlists").insert([{ title, venue, bit_ids: setlist }]).select().single();
      if (data) setActiveId(data.id);
    }
    setIsSaving(false);
    
    // Slungar dig till Skriv-fliken med rätt skämt!
    router.push(`/workshop?id=${bitId}`);
  };

  const showSaved = () => {
    setSaved(true);
    setTimeout(() => setSaved(false), 2000);
  };

  const deleteSetlist = async (e: React.MouseEvent, id: string) => {
    e.stopPropagation();
    if (window.confirm("Är du helt säker på att du vill radera denna setlist?")) {
      const { error } = await supabase.from("setlists").delete().eq("id", id);
      if (!error) {
        if (activeId === id) startNew();
        fetchData();
      }
    }
  };

  const addBit = (bitId: string) => {
    if (!setlist.includes(bitId)) {
      setSetlist([...setlist, bitId]);
    }
  };

  const removeBit = (e: React.MouseEvent, bitId: string) => {
    e.stopPropagation();
    setSetlist(setlist.filter(id => id !== bitId));
  };

  // --- NYA DRAG & DROP-FUNKTIONER ---
  const onDragStart = (e: React.DragEvent, index: number) => {
    setDraggedIndex(index);
    e.dataTransfer.effectAllowed = "move";
  };

  const onDragOver = (e: React.DragEvent, index: number) => {
    e.preventDefault(); 
    e.dataTransfer.dropEffect = "move";
  };

  const onDrop = (e: React.DragEvent, dropIndex: number) => {
    e.preventDefault();
    if (draggedIndex === null || draggedIndex === dropIndex) return;

    const newSetlist = [...setlist];
    // Plockar ut skämtet vi drog i...
    const draggedBitId = newSetlist.splice(draggedIndex, 1)[0];
    // ...och stoppar in det på den nya platsen
    newSetlist.splice(dropIndex, 0, draggedBitId);
    
    setSetlist(newSetlist);
    setDraggedIndex(null);
  };

  const availableBits = allBits.filter(bit => !setlist.includes(bit.id));
  const setlistBits = setlist.map(id => allBits.find(b => b.id === id)).filter(Boolean);

  return (
    <div className="h-full flex flex-col md:flex-row bg-neutral-950">
      
      <div className="w-full md:w-80 border-r border-neutral-800 bg-neutral-900/50 p-6 flex flex-col">
        <h2 className="text-xl font-bold text-white mb-6 flex items-center gap-2">
          <ListMusic className="text-blue-500" /> Mina Setlists
        </h2>
        
        <button 
          onClick={startNew}
          className="w-full mb-6 bg-blue-600 hover:bg-blue-500 text-white font-medium py-3 px-4 rounded-lg flex items-center justify-center gap-2 transition-colors"
        >
          <Plus size={18} /> Skapa Ny Setlist
        </button>

        <div className="flex-1 overflow-y-auto space-y-3 pr-2 scrollbar-hide">
          {savedSetlists.map((setlistObj) => (
            <div 
              key={setlistObj.id}
              onClick={() => loadSetlist(setlistObj)}
              className={`p-4 rounded-xl cursor-pointer border transition-all group ${
                activeId === setlistObj.id 
                  ? 'bg-neutral-800 border-blue-500/50 shadow-md' 
                  : 'bg-neutral-900 border-neutral-800 hover:border-neutral-700'
              }`}
            >
              <div className="flex justify-between items-start mb-1">
                <h3 className="font-semibold text-white group-hover:text-blue-400 transition-colors truncate pr-2">
                  {setlistObj.title || "Namnlös Setlist"}
                </h3>
                <button 
                  onClick={(e) => deleteSetlist(e, setlistObj.id)}
                  className="text-neutral-600 hover:text-red-500 opacity-0 group-hover:opacity-100 transition-opacity"
                >
                  <Trash2 size={16} />
                </button>
              </div>
              <p className="text-xs text-neutral-500 flex items-center gap-1">
                <MapPin size={12} /> {setlistObj.venue || "Ingen plats angiven"}
              </p>
              <p className="text-xs text-blue-500/80 mt-3 font-medium bg-blue-500/10 w-fit px-2 py-1 rounded-md">
                {setlistObj.bit_ids ? setlistObj.bit_ids.length : 0} bitar
              </p>
            </div>
          ))}
        </div>
      </div>

      <div className="flex-1 p-6 md:p-10 flex flex-col h-full overflow-hidden">
        
        <div className="flex justify-between items-start mb-6 shrink-0">
          <div className="flex-1 max-w-xl">
            <input
              type="text"
              placeholder="Namn på setlist (t.ex. Gig på Norra Brunn)..."
              className="bg-transparent text-3xl font-bold outline-none text-white placeholder-neutral-600 w-full mb-2"
              value={title}
              onChange={(e) => setTitle(e.target.value)} 
            />
            <div className="flex items-center gap-2 text-neutral-400">
              <MapPin size={18} />
              <input
                type="text"
                placeholder="Plats, stad eller anteckningar..."
                className="bg-transparent outline-none text-sm w-full placeholder-neutral-600"
                value={venue}
                onChange={(e) => setVenue(e.target.value)} 
              />
            </div>
          </div>
          
          <button 
            onClick={handleSave}
            disabled={isSaving || !title} 
            className={`flex items-center gap-2 px-6 py-3 rounded-lg font-medium transition-colors ${
              saved ? "bg-green-600 text-white" : "bg-white text-black hover:bg-neutral-200"
            } ${(isSaving || !title) ? "opacity-50 cursor-not-allowed" : ""}`}
          >
            {saved ? <Check size={18} /> : <Save size={18} />}
            {saved ? "Sparad!" : "Spara Setlist"}
          </button>
        </div>

        <div className="flex-1 flex flex-col xl:flex-row gap-6 overflow-hidden min-h-[400px]">
          
          {/* VÄNSTER KOLUMN: Biblioteket */}
          <div className="flex-1 bg-neutral-900 border border-neutral-800 rounded-xl flex flex-col overflow-hidden">
            <div className="p-4 border-b border-neutral-800 bg-neutral-900/80">
              <h3 className="font-semibold text-neutral-300 flex items-center gap-2">
                <FolderOpen size={18} className="text-blue-500" /> Ditt Bibliotek
              </h3>
              <p className="text-xs text-neutral-500 mt-1">Klicka på en bit för att lägga till den.</p>
            </div>
            
            <div className="flex-1 overflow-y-auto p-4 space-y-3">
              {availableBits.length === 0 ? (
                <p className="text-sm text-neutral-500 text-center mt-10">Inga fler skämt i biblioteket!</p>
              ) : (
                availableBits.map(bit => (
                  <div 
                    key={bit.id} 
                    onClick={() => addBit(bit.id)}
                    className="p-3 bg-neutral-950 border border-neutral-800 rounded-lg cursor-pointer hover:border-blue-500/50 group transition-colors flex items-center justify-between"
                  >
                    <div className="pr-4">
                      <h4 className="text-sm font-semibold text-white mb-1">{bit.title}</h4>
                      <p className="text-xs text-neutral-500 line-clamp-1">{bit.premise}</p>
                    </div>
                    <button className="text-neutral-600 group-hover:text-blue-400 bg-neutral-900 p-2 rounded-md">
                      <ArrowRight size={16} />
                    </button>
                  </div>
                ))
              )}
            </div>
          </div>

          {/* HÖGER KOLUMN: Setlistan med Drag and Drop */}
          <div className="flex-1 bg-neutral-900 border border-neutral-800 rounded-xl flex flex-col overflow-hidden shadow-inner">
            <div className="p-4 border-b border-neutral-800 bg-neutral-900/80 flex justify-between items-center">
              <div>
                <h3 className="font-semibold text-white flex items-center gap-2">
                  <ListMusic size={18} className="text-purple-500" /> Aktuell Ordning
                </h3>
                <p className="text-xs text-neutral-500 mt-1">{setlistBits.length} skämt valda. Dubbelklicka för att redigera.</p>
              </div>
            </div>
            
            <div className="flex-1 overflow-y-auto p-4 space-y-3">
              {setlistBits.length === 0 ? (
                <div className="h-full flex flex-col items-center justify-center text-neutral-600 border-2 border-dashed border-neutral-800 rounded-lg p-6 text-center">
                  <ListMusic size={32} className="mb-3 opacity-20" />
                  <p className="text-sm">Din setlist är tom.</p>
                  <p className="text-xs mt-1">Hämta skämt från biblioteket till vänster!</p>
                </div>
              ) : (
                setlistBits.map((bit, index) => (
                  <div 
                    key={bit.id} 
                    draggable
                    onDragStart={(e) => onDragStart(e, index)}
                    onDragOver={(e) => onDragOver(e, index)}
                    onDrop={(e) => onDrop(e, index)}
                    onDoubleClick={() => handleSaveAndNavigate(bit.id)}
                    title="Dubbelklicka för att spara och redigera skämtet"
                    className={`p-3 bg-neutral-950 border-l-4 border-l-purple-500 border-y border-r border-neutral-800 rounded-lg flex items-center justify-between shadow-sm cursor-grab active:cursor-grabbing hover:border-purple-500/50 transition-colors ${draggedIndex === index ? 'opacity-50 border-dashed' : 'opacity-100'}`}
                  >
                    <div className="flex items-center gap-3 w-full">
                      {/* Drag-handtaget */}
                      <div className="text-neutral-600 hover:text-white p-1">
                        <GripVertical size={18} />
                      </div>
                      
                      <div className="flex-1">
                        <div className="flex items-center gap-2">
                          <span className="text-xs font-mono font-bold text-neutral-500">{index + 1}.</span>
                          <h4 className="text-sm font-semibold text-white">{bit.title}</h4>
                        </div>
                        {bit.tags && bit.tags.length > 0 && (
                          <div className="flex gap-1 mt-1.5">
                            {bit.tags.slice(0,2).map((t: string) => (
                              <span key={t} className="text-[9px] px-1.5 py-0.5 bg-neutral-800 text-neutral-400 rounded">#{t}</span>
                            ))}
                          </div>
                        )}
                      </div>
                    </div>
                    
                    <button 
                      onClick={(e) => removeBit(e, bit.id)}
                      className="text-neutral-600 hover:text-red-400 p-2 transition-colors shrink-0"
                      title="Ta bort från setlist"
                    >
                      <Trash2 size={16} />
                    </button>
                  </div>
                ))
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}